# NAADAMAYA frontend configuration (public values only).
# Never put a secret here: everything in a Vite app is visible in the browser.

# Leave EMPTY in development: the Vite proxy forwards /api to http://localhost:8000.
# In production set it to your API origin, for example https://api.example.com
# (and add the frontend's exact origin to the backend CORS_ORIGINS).
VITE_API_BASE_URL=
