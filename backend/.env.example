# ==========================================================
# NAADAMAYA backend configuration
# Copy to .env and fill in real values. Never commit .env.
# ==========================================================

# ---- App ----
APP_NAME=NAADAMAYA
ENVIRONMENT=development            # development | staging | production
DEBUG=true                         # must be false in production
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
# Comma-separated list. Use the exact production domain in production, never "*".
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
DATABASE_URL=postgresql+psycopg://naadamaya:naadamaya@db:5432/naadamaya

# ---- Redis (cache, rate limits, Celery) ----
REDIS_URL=redis://redis:6379/0

# ---- Tokens ----
# Generate each secret with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
# Separate key used to hash OTPs and refresh tokens before storing them.
TOKEN_HASH_SECRET=change-me-to-another-long-random-string

# ---- OTP ----
OTP_MODE=development               # development | production
OTP_PROVIDER=mock                  # mock | msg91 | twilio (mock is refused in production)
OTP_LENGTH=6
OTP_EXPIRE_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
# Development only. When OTP_MODE=development, every OTP is this value.
# Ignored (and refused) in production.
OTP_DEV_FIXED_CODE=123456
DEFAULT_COUNTRY_CODE=IN

# SMS provider credentials (only the provider you choose is used)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Razorpay ----
# RAZORPAY_KEY_ID is safe to expose to the frontend.
# RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET must stay on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- File storage ----
STORAGE_PROVIDER=local             # local | s3 (s3 covers AWS S3 and Cloudflare R2)
STORAGE_LOCAL_DIR=/data/uploads    # kept outside the application code
STORAGE_BUCKET=
S3_ENDPOINT_URL=                   # leave empty for AWS S3; set for Cloudflare R2
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
SIGNED_URL_EXPIRE_SECONDS=600

# ---- Uploads ----
MAX_UPLOAD_SIZE_MB=50
MAX_AUDIO_DURATION_SECONDS=900
MIN_AUDIO_DURATION_SECONDS=3

# ---- Analysis ----
# mock = clearly labelled simulated results, for frontend development only.
# real = actual audio analysis. The app refuses to start with mock in production.
ANALYSIS_MODE=mock
ANALYSIS_VERSION=1.0.0
ANALYSIS_SAMPLE_RATE=22050

# ---- Rate limits (requests per window) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_OTP_PER_IP_PER_HOUR=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_ANALYSIS_PER_HOUR=20

# ---- Logging ----
LOG_LEVEL=INFO
